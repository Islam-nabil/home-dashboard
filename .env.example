# Copy this file to .env and edit values. app.py/config.py load .env
# automatically. Nothing here is required to get started — every setting
# has a sensible default (see config.py).

# --- Core budget ---
TOTAL_BUDGET_EGP=180000
CURRENCY=EGP

# --- Database ---
# DATABASE_PATH=./data/dashboard.db

# --- Price monitoring ---
PRICE_CHECK_FREQUENCY_HOURS=12
REQUEST_TIMEOUT_SECONDS=12
MIN_REQUEST_INTERVAL_SECONDS=3

# --- Deal score thresholds (0-100) ---
DEAL_THRESHOLD_EXCEPTIONAL=90
DEAL_THRESHOLD_GOOD=75
DEAL_THRESHOLD_FAIR=60
DEAL_THRESHOLD_WAIT=40

# --- Notifications ---
# JSON array string, e.g. '["in_app","email"]'
NOTIFICATION_CHANNELS=["in_app"]

# Email (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Telegram (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional LLM polish for the assistant panel (never required) ---
# ANTHROPIC_API_KEY=
# ENABLE_LLM_ASSISTANT_POLISH=false

# --- Flask ---
SECRET_KEY=change-me-to-something-random
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
