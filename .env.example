# Copy this file to .env and edit values. app.py/config.py load .env
# automatically. Nothing here is required to get started — every setting
# has a sensible default (see config.py).

# --- Core budget ---
TOTAL_BUDGET_EGP=180000
CURRENCY=EGP

# --- Database ---
# DATABASE_PATH=./data/dashboard.db

# --- Price monitoring ---
PRICE_CHECK_FREQUENCY_HOURS=12
REQUEST_TIMEOUT_SECONDS=12
MIN_REQUEST_INTERVAL_SECONDS=3

# --- Deal score thresholds (0-100) ---
DEAL_THRESHOLD_EXCEPTIONAL=90
DEAL_THRESHOLD_GOOD=75
DEAL_THRESHOLD_FAIR=60
DEAL_THRESHOLD_WAIT=40

# --- Notifications ---
# JSON array string, e.g. '["in_app","email"]'
NOTIFICATION_CHANNELS=["in_app"]

# Email (optional — leave blank to disable). For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=your gmail address, SMTP_PASSWORD=a 16-character
# "App Password" (myaccount.google.com/apppasswords — NOT your regular Gmail
# password; requires 2-Step Verification to be turned on first).
# NOTIFY_EMAIL_TO is the default recipient list — comma-separated, e.g. both
# your and your fiancée's email. This can also be changed later from the
# Settings page in the app without editing this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=you@example.com,fiancee@example.com

# Telegram (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional LLM polish for the assistant panel (never required) ---
# The assistant works fully without this — it's a deterministic answer
# engine that only reads your own data. Setting this just makes its replies
# read more like natural conversation instead of a templated sentence; it
# can never add facts, prices, or numbers that aren't already true.
#
# Recommended: Groq, because it's free and already allowed through on
# PythonAnywhere's free plan. Get a key at https://console.groq.com/keys
# (sign in, "API Keys" in the left nav, "Create API Key"). It serves
# Llama 3.3 70B, an open-weight model, at no cost.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Anthropic is used as a fallback only if GROQ_API_KEY isn't set (paid).
# ANTHROPIC_API_KEY=
#
# Turn the polish step on (needs one of the two keys above too):
# ENABLE_LLM_ASSISTANT_POLISH=false

# --- Flask ---
SECRET_KEY=change-me-to-something-random
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# --- Optional password gate (recommended once deployed publicly) ---
# Set both to turn on an HTTP Basic Auth prompt for the whole app. Leave
# blank for local-only use.
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
